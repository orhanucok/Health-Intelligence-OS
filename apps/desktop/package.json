{
  "name": "@health-intelligence/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write src tests *.json *.ts *.html src-tauri/*.json",
    "format:check": "prettier --check src tests *.json *.ts *.html src-tauri/*.json",
    "lint": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@health-intelligence/contracts": "0.1.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "2.7.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.6.0",
    "jsdom": "26.1.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
